{
  "opencollection": "1.0.0",
  "info": {
    "name": "Action (Matter) Bill Settings Action Bill Settings Action Folders API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Action Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /actionfolders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.actionstep.com/actionfolders"
          },
          "docs": "Returns the collection of all folders for all Matters. For information on how to construct requests filtering by various properties, please refer to the API Developer Portal."
        },
        {
          "info": {
            "name": "GET /actionfolders/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.actionstep.com/actionfolders/:id",
            "params": [
              {
                "name": "id",
                "value": "1050",
                "type": "path",
                "description": "Unique identifier for a Matter folder."
              }
            ]
          },
          "docs": "Returns a single Matter folder."
        }
      ]
    }
  ],
  "bundled": true
}